# Public site URL used for canonical links, sitemap, and Open Graph.
# Checkout uses this origin in production. Locally it follows the request host.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123

# Signs download links. Required in production. Use a long random string.
DOWNLOAD_SECRET=replace-with-a-long-random-string

# How many days a download link stays valid.
DOWNLOAD_LINK_DAYS=14

# Stripe Checkout. Leave blank to hide the card option.
# Demo checkout remains only when PayPal and Moyasar are blank too.
# Secret key: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Publishable key is unused by hosted Checkout, kept here if you add Stripe.js later.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret for /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# PayPal Orders v2. Leave the id and secret blank to hide the PayPal button.
# Create a REST app in the PayPal developer dashboard:
# https://developer.paypal.com/dashboard/applications
# Sandbox credentials live on the sandbox app. Live credentials live on the live app.
# Copy the Client ID and Secret into the Vercel project. Do not commit them.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" (default) or "live". Only the exact value live calls the live API.
PAYPAL_ENV=sandbox
# Optional. Webhook id for POST /api/paypal/webhook.
# Fulfillment happens on the return URL after capture is verified, not in the webhook.
PAYPAL_WEBHOOK_ID=

# Apple Pay via PayPal. Uses the same PAYPAL_CLIENT_ID and PAYPAL_CLIENT_SECRET.
# The browser loads the PayPal JS SDK from GET /api/paypal/config, which returns
# the client id and never the secret. Do not put the secret in a NEXT_PUBLIC_ variable.
# NEXT_PUBLIC_PAYPAL_CLIENT_ID is not required.
#
# Apple Pay shows only in Safari on a Mac or on iOS, with a card in Wallet, over HTTPS,
# on a domain registered with PayPal. Sandbox support is limited.
#
# Setup:
# 1. Use a live PayPal business account that is eligible for Apple Pay via PayPal.
#    Advanced Credit and Debit Card Payments must be approved.
# 2. Enable Apple Pay: Account settings > Payment methods > Apple Pay.
#    In the developer dashboard, on the live app, confirm Apple Pay is enabled
#    under Features (or Accept payments > Advanced Credit and Debit Card Payments).
# 3. Register the production domain in PayPal's Apple Pay domain settings
#    (the host of NEXT_PUBLIC_SITE_URL, with no path). Register www and the apex
#    separately if both serve the site.
# 4. Download PayPal's domain association file and paste its contents below.
#    Do not add quotes. One URL serves the file. See the note under Moyasar.
# 5. Set PAYPAL_ENV=live and use the live app's client id and secret.
APPLE_PAY_DOMAIN_ASSOCIATION=

# Moyasar (mada, Visa/Mastercard, Apple Pay, STC Pay). Leave both keys blank to hide the option.
# Create an account at https://dashboard.moyasar.com/ and copy the API keys.
# Sandbox keys start with pk_test_ and sk_test_. Live keys start with pk_live_ and sk_live_.
# The publishable key is used by Moyasar's payment form in the browser. The secret key stays on the server.
# Never commit either key. Set them in the Vercel project environment.
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
# Optional. Shared secret you set on the Moyasar webhook (Settings → Webhooks).
# Point it at https://YOUR_DOMAIN/api/moyasar/webhook for payment_paid.
# Downloads are issued on the callback after the payment is fetched, not by the webhook.
MOYASAR_WEBHOOK_SECRET=
# Catalog prices are USD. Moyasar charges SAR in halalas using this rate.
# 3.75 is the official USD/SAR peg. Override only if you intend a different rate.
USD_TO_SAR_RATE=3.75
# Optional. Paste the Apple Pay domain association file body from the Moyasar dashboard
# (Settings → Apple Pay Domains → Download Association).
#
# Both Apple Pay providers share one path:
# /.well-known/apple-developer-merchantid-domain-association
# The route serves whichever of these two variables is set, with status 200,
# Content-Type application/octet-stream, and no redirect.
# If you use both PayPal Apple Pay and Moyasar Apple Pay, set only one of them.
# They are different files from different dashboards, and Apple allows only one
# file at that path. If both are set and the bytes differ, the route returns 409
# and serves neither file.
MOYASAR_APPLE_PAY_DOMAIN_ASSOCIATION=

# Set to true only if you want the free demo checkout to stay available
# after Stripe, PayPal, or Moyasar keys are present. Leave unset on a live store.
ALLOW_DEMO_CHECKOUT=

# Optional. POST JSON to these URLs for contact and newsletter submissions.
CONTACT_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=
