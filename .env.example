# Public site URL used for canonical links, sitemap, and Open Graph.
# Checkout uses this origin in production. Locally it follows the request host.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123

# Signs download links. Required in production. Use a long random string.
DOWNLOAD_SECRET=replace-with-a-long-random-string

# How many days a download link stays valid.
DOWNLOAD_LINK_DAYS=14

# Stripe Checkout. Leave blank to use the labeled demo checkout.
# Secret key: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Publishable key is unused by hosted Checkout, kept here if you add Stripe.js later.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret for /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Set to true only if you want the free demo checkout to stay available
# after Stripe keys are present. Leave unset on a live store.
ALLOW_DEMO_CHECKOUT=

# Optional. POST JSON to these URLs for contact and newsletter submissions.
CONTACT_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=
