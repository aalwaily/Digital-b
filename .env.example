# Public site URL for checkout return links in production. Locally it follows the request host.
# SEO canonicals, the sitemap, and hreflang are fixed to https://getvellumpress.com.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123

# Search Console HTML-tag verification: paste only the content value, not the whole meta tag.
# Either Google name is read. Leave blank to omit the meta tag.
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster verification: paste only the msvalidate.01 content value.
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Signs download links. Required in production. Use a long random string.
DOWNLOAD_SECRET=replace-with-a-long-random-string

# How many days a download link stays valid.
DOWNLOAD_LINK_DAYS=14

# Stripe Checkout stays in the repo but is hidden unless this is exactly true.
# Both the flag and STRIPE_SECRET_KEY are required before the Stripe button appears.
ENABLE_STRIPE=
# Secret key: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Publishable key is unused by hosted Checkout, kept here if you add Stripe.js later.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret for /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Moyasar (mada, Visa/Mastercard, Apple Pay, STC Pay) stays in the repo but is hidden
# unless this is exactly true. Both the flag and a matching key pair are required.
ENABLE_MOYASAR=
# Leave both keys blank to hide the option even when the flag is true.
# Create an account at https://dashboard.moyasar.com/ and copy the API keys.
# Sandbox keys start with pk_test_ and sk_test_. Live keys start with pk_live_ and sk_live_.
# The publishable key is used by Moyasar's payment form in the browser. The secret key stays on the server.
# Never commit either key. Set them in the Vercel project environment.
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
# Optional. Shared secret you set on the Moyasar webhook (Settings → Webhooks).
# Point it at https://YOUR_DOMAIN/api/moyasar/webhook for payment_paid.
# Downloads are issued on the callback after the payment is fetched, not by the webhook.
MOYASAR_WEBHOOK_SECRET=
# Catalog prices are USD. Moyasar charges SAR in halalas using this rate.
# 3.75 is the official USD/SAR peg. Override only if you intend a different rate.
USD_TO_SAR_RATE=3.75
# Optional. Paste the Apple Pay domain association file body from the Moyasar dashboard
# (Settings → Apple Pay Domains → Download Association).
#
# Served at /.well-known/apple-developer-merchantid-domain-association
# with status 200, Content-Type application/octet-stream, and no redirect.
# Used only when Moyasar Apple Pay is registered.
MOYASAR_APPLE_PAY_DOMAIN_ASSOCIATION=

# Active hosted checkout. Leave unset until Hala can take a payment.
# "hala" selects Hala in lib/checkout-provider.ts. The pay button stays hidden
# until HALA_HOSTED_CHECKOUT_IMPLEMENTED in lib/hala.ts is true, so customers
# are not sent to a route that cannot charge them.
# Hala (هلا للمدفوعات, https://hala.com) has no public API docs yet.
# Any other value, including paypal, stripe, or a blank one, leaves Hala off.
PAYMENT_PROVIDER=
# Secret key for a future Hala hosted checkout. Ignored unless PAYMENT_PROVIDER=hala.
# TODO: Replace the placeholder in lib/hala.ts when Hala publishes the API.
HALA_API_KEY=
# HMAC secret for POST /api/hala/webhook. The route verifies this signature,
# marks the order paid, and only then returns the PDF download link.
# Ignored unless PAYMENT_PROVIDER=hala.
HALA_WEBHOOK_SECRET=

# Set to exactly true only for a private test that should issue a signed
# download from POST /api/checkout. The storefront does not show this path.
# Leave unset on a live store. A closed checkout asks people to email instead.
ALLOW_DEMO_CHECKOUT=

# Optional. POST JSON to this URL for contact-form submissions.
CONTACT_WEBHOOK_URL=
# Optional. POST JSON here for newsletter signups and free-sample requests.
# When this is blank, those addresses are written to the server log instead.
NEWSLETTER_WEBHOOK_URL=

# Optional analytics. Each snippet loads only when its id is set.
# Invalid values are ignored. Leave them blank to ship with no third-party scripts.
# Purchase events fire on the receipt page for real (non-demo) orders.
# Google Analytics 4 measurement id, for example G-XXXXXXXX
NEXT_PUBLIC_GA_ID=
# Meta Pixel id, digits only.
NEXT_PUBLIC_META_PIXEL_ID=
# TikTok Pixel id.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
